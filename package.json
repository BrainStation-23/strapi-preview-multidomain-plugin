{
  "version": "1.0.0",
  "keywords": ["Strapi", "Strapi 5", "Plugin", "Preview Button", "Multidomain"],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": "./strapi-server.js"
  },
  "files": [
    "dist",
    "strapi-server.js",
    "server"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0-rc.27",
    "@strapi/icons": "^2.0.0-rc.27",
    "react-intl": "^7.1.11"
  },
  "devDependencies": {
    "@strapi/strapi": "^5.16.1",
    "@strapi/sdk-plugin": "^5.3.2",
    "prettier": "^3.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.19"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.16.1",
    "@strapi/sdk-plugin": "^5.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.19",
    "strapi-plugin-preview-button": "^3.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "preview-button-multidomain",
    "displayName": "Preview Button Multidomain",
    "description": "Extends strapi-plugin-preview-button with multi-domain preview host selection via before-build-url."
  },
  "name": "preview-button-multidomain",
  "description": "Strapi 5 extender for preview-button: multi-domain draft/published preview hosts.",
